# Financial Report Intelligence System - Environment Variables
# Copy this file to .env and fill in your actual values

# Application
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# LLM API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# Data Source APIs
NEWSAPI_KEY=your-newsapi-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
MARKET_DATA_API_KEY=your-market-data-key
FINNHUB_API_KEY=your-finnhub-key

# Database Credentials
POSTGRES_USER=finrag
POSTGRES_PASSWORD=finrag_postgres_pass
POSTGRES_DB=finrag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=finrag_redis_pass
REDIS_DB=0

# Vector Database (Weaviate)
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=finrag-api-key

# Graph Database (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=finrag_password
NEO4J_DATABASE=neo4j

# Kafka Message Broker
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=finrag-consumers

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# SMTP Configuration for Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@finrag.example.com

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=finrag_grafana_pass

# AWS (if using AWS services)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=finrag-data

# Azure (if using Azure services)
AZURE_STORAGE_CONNECTION_STRING=your-azure-connection-string
AZURE_CONTAINER_NAME=finrag-data

# Feature Flags
ENABLE_HALLUCINATION_DETECTION=true
ENABLE_TEMPORAL_FILTERING=true
ENABLE_COMPLIANCE_CHECKING=true
ENABLE_CACHING=true
ENABLE_AUDIT_LOGGING=true

# Performance
MAX_CONCURRENT_REQUESTS=100
QUERY_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# Logging
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=/app/logs/finrag.log
LOG_FILE_MAX_SIZE=100MB
LOG_FILE_BACKUP_COUNT=5

# Development
DEV_RELOAD=false
DEV_MOCK_LLM=false
DEV_MOCK_DATA_SOURCES=false
